# Copy to .env.local. URL of the running `langgraph dev` server (apps/agent).
LANGGRAPH_API_URL=http://localhost:2024
# Graph name from apps/agent/langgraph.json
LANGGRAPH_ASSISTANT_ID=agent

# Supabase project credentials (Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
